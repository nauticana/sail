{
  "name": "@nauticana/sail",
  "version": "1.2.1",
  "description": "Metadata-driven Angular component library for CRUD admin frontends backed by the keel Go backend. Tables, forms, navigation, OTP/2FA/social auth, billing, payout onboarding.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/model/decorator.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:templates": "ngc -p tsconfig.json",
    "check": "npm run typecheck && npm run check:templates"
  },
  "files": [
    "src/",
    "tsconfig.json"
  ],
  "keywords": [
    "angular",
    "angular-library",
    "crud",
    "admin",
    "keel",
    "nauticana",
    "metadata-driven",
    "material",
    "auth",
    "2fa",
    "otp"
  ],
  "license": "Apache-2.0",
  "author": "Nauticana",
  "homepage": "https://github.com/nauticana/sail#readme",
  "bugs": {
    "url": "https://github.com/nauticana/sail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nauticana/sail.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "class-validator": "^0.15.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "class-validator": "^0.15.1",
    "rxjs": "~7.8.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  }
}
